"""ADP（Agent Discovery Protocol）发现客户端。
按已核实 schema（acps_sdk/adp/models.py 的 DiscoveryRequest/DiscoveryResponse）构造请求、
解析响应。线格式为 camelCase（官方 to_dict(by_alias=True) 输出）。
真实发现请求走梧桐平台 `POST {base_url}/acps-adp-v2/discover`，需要 mTLS 证书；
本模块的 `discover` 用 httpx 发起真实网络请求，不提供本地假实现。
"""
from __future__ import annotations
import ssl
from pathlib import Path
from typing import Any


def build_discovery_request(
    query: str,
    *,
    type: str = "explicit",
    limit: int | None = 5,
    context: dict[str, Any] | None = None,
    filter: dict[str, Any] | None = None,
) -> dict[str, Any]:
    """构造 ADP 发现请求（camelCase 线格式）。
    字段语义对齐 acps_sdk/adp/models.py DiscoveryRequest：
    type ∈ explicit/exploratory/trending/filtered；explicit 时 query 必填。
    """
    req: dict[str, Any] = {"type": type, "query": query}
    if limit is not None:
        req["limit"] = limit
    if context is not None:
        req["context"] = context
    if filter is not None:
        req["filter"] = filter
    return req


def build_ssl_context(
    ca_bundle: str | Path,
) -> ssl.SSLContext:
    """构建同时信任系统默认 CA 和平台 CA bundle 的 SSLContext。

    Args:
        ca_bundle: 平台 CA bundle 文件路径。

    Returns:
        配置完成的 ssl.SSLContext（CERT_REQUIRED + 系统 CA + 平台 CA）。

    Raises:
        FileNotFoundError: ca_bundle 文件不存在。
        ssl.SSLError: ca_bundle 无法加载或格式无效。
        ValueError: ca_bundle 路径为空。
    """
    if not ca_bundle:
        raise ValueError("ca_bundle path must not be empty")
    bundle_path = Path(ca_bundle)
    if not bundle_path.exists():
        raise FileNotFoundError(f"CA bundle not found: {bundle_path}")
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    ctx.check_hostname = True
    ctx.verify_mode = ssl.CERT_REQUIRED
    # 先加载系统默认 CA（含 certifi / OS trust store）
    ctx.load_default_certs()
    # 再追加平台 CA bundle
    try:
        ctx.load_verify_locations(cafile=str(bundle_path))
    except ssl.SSLError as exc:
        raise ssl.SSLError(
            f"Failed to load CA bundle {bundle_path}: {exc}"
        ) from exc
    return ctx


def discover(
    query: str,
    *,
    base_url: str,
    cert: tuple[str, str] | None = None,  # (cert_file, key_file)，mTLS
    verify: str | bool | ssl.SSLContext = True,  # trust bundle 路径 / SSLContext / False
    timeout: float = 30.0,
    **request_kwargs: Any,
) -> dict[str, Any]:
    """向发现服务发起真实 discover 请求，返回响应 JSON（result/error）。

    Args:
        verify: 支持三种类型：
            - ssl.SSLContext: 直接使用，不做任何修改。
            - str / Path: 视为 CA bundle 路径，自动构建合并系统 CA 的 SSLContext。
              若文件不存在或无法加载，抛出明确异常，不会静默降级。
            - True: 使用 httpx 默认验证（系统 CA）。
            - False: 禁止。TLS 验证不可关闭。
    """
    import httpx

    # 禁止关闭 TLS 验证
    if verify is False:
        raise ValueError(
            "TLS verification cannot be disabled for Discovery requests. "
            "Pass a CA bundle path or ssl.SSLContext instead."
        )

    # 如果传入字符串路径，构建合并 SSLContext
    if isinstance(verify, (str, Path)):
        verify = build_ssl_context(verify)

    payload = build_discovery_request(query, **request_kwargs)
    url = base_url.rstrip("/") + "/acps-adp-v2/discover"
    with httpx.Client(cert=cert, verify=verify, timeout=timeout) as client:
        resp = client.post(url, json=payload)
        resp.raise_for_status()
        return resp.json()


def response_agents(response: dict[str, Any]) -> list[tuple[str, dict[str, Any], str]]:
    """从发现响应中提取候选智能体 (aic, acs, group) 三元组。
    对齐 DiscoveryResult：result.acsMap{AIC→ACS} + result.agents[].agentSkills[]。
    """
    result = response.get("result") or {}
    acs_map = result.get("acsMap") or {}
    out: list[tuple[str, dict[str, Any], str]] = []
    for group in result.get("agents") or []:
        for skill in group.get("agentSkills") or []:
            aic = skill.get("aic", "")
            out.append((aic, acs_map.get(aic, {}), group.get("group", "")))
    return out
