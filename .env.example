# ================= DeepSeek（文本任务，OpenAI 兼容 API） =================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TIMEOUT=60

# ================= Qwen（多模态任务，后续阶段启用） =================
# Qwen 的 Key 现存于环境变量 LLM_API_KEY，本轮未接入

# ================= 应用配置 =================
SERVICE_NAME=EduAgent
APP_HOST=127.0.0.1
APP_PORT=8000

# ================= CORS 白名单（Phase 0/I3） =================
# 逗号分隔；默认仅放行本机开发源。部署时改为前端实际访问来源。
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ================= AIP 智能体互联（ACP_ENABLED=true 时启用） =================
# 全部可选；真实注册/发现/互联/跨端访问须走梧桐平台 + 官方 acps_sdk。
# ACP_ENABLED=true
# ACP_AIC=<平台审核通过后分配的 AIC，如 1.2.156.3088.1.ABC.XYZ.12345.0001.ABCD>
# ACP_NAME=EduMate-AIP
# ACP_SERVICE_HOST=<平台可达的主机名或公网地址>
# ACP_SERVICE_PORT=9443
# ACP_PUBLIC_BASE_URL=https://<公网域名或IP>:<端口>  # 产物/端点公开基址（缺省回退 SERVICE_HOST:PORT）
# ACP_MTLS_SERVER=true                 # 仅 9443 AIP 进程开启；业务 8000 不设此值
# ACP_KEY_PATH=agent-server-key.pem    # serverAuth 私钥（本进程 TLS 服务端身份）
# ACP_CERT_PATH=agent-server-cert.pem  # serverAuth 证书（CN=AIC）
# ACP_TRUST_BUNDLE_PATH=trust-bundle.pem  # 验证入站客户端证书的 CA
# ACP_IDENTITY_BINDING_ENABLED=true
# ACP_REGISTRY_BASE_URL=https://wt.ioa.pub/registry-server
# ACP_DISCOVERY_BASE_URL=https://wt.ioa.pub/discovery
# ACP_CA_BASE_URL=https://wt.ioa.pub/ca-server
# ACP_MQ_HOST=localhost
# ACP_MQ_PORT=5671
# ACP_MQ_VHOST=acps
# ACP_AMP_LOG_PATH=logs/amp.jsonl

# ================= API 认证（Phase 2 / S6，§10.5 / 决策⑪） =================
# Access Token：不设置则 API fail-closed（仅 /api/health 可用）；
# 客户端以 Authorization: Bearer <token> 或 X-API-Token 头携带。
EDUMATE_API_TOKEN=

# ================= MCP 能力开放（Phase 5 / S4，§8.3 / 决策㊾③） =================
# 管理员 Token：远程 Streamable HTTP 调用敏感工具 diagnose_learning_gaps 需要；
# 普通 EDUMATE_API_TOKEN 只能调用检索/题库工具。不设置则管理员权限不可用。
# EDUMATE_MCP_ADMIN_TOKEN=
# 敏感工具环境总开关（默认 0 关闭）：1=开启（管理员/本地 stdio 可调用）。
# EDUMATE_MCP_ALLOW_SENSITIVE=0
# DNS Rebinding 防护白名单（逗号分隔；默认已覆盖本地回环 + 正式域名，通常无需修改）。
# Host 不在白名单 → 421；Origin 不在白名单 → 403。
# EDUMATE_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*,edumateaip.xyz,edumateaip.xyz:*
# EDUMATE_MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*,https://edumateaip.xyz,http://edumateaip.xyz
