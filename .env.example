# ================= DeepSeek（文本任务，OpenAI 兼容 API） =================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TIMEOUT=60

# ================= Qwen（多模态任务，后续阶段启用） =================
# Qwen 的 Key 现存于环境变量 LLM_API_KEY，本轮未接入

# ================= 应用配置 =================
SERVICE_NAME=EduAgent
APP_HOST=127.0.0.1
APP_PORT=8000

# ================= AIP 智能体互联（ACP_ENABLED=true 时启用） =================
# 全部可选；真实注册/发现/互联/跨端访问须走梧桐平台 + 官方 acps_sdk。
# ACP_ENABLED=true
# ACP_AIC=<平台审核通过后分配的 AIC，如 1.2.156.3088.1.ABC.XYZ.12345.0001.ABCD>
# ACP_NAME=EduMate-AIP
# ACP_SERVICE_HOST=<平台可达的主机名或公网地址>
# ACP_SERVICE_PORT=9443
# ACP_KEY_PATH=agent-key.pem
# ACP_CERT_PATH=agent-cert.pem
# ACP_TRUST_BUNDLE_PATH=trust-bundle.pem
# ACP_IDENTITY_BINDING_ENABLED=true
# ACP_REGISTRY_BASE_URL=https://wt.ioa.pub/registry-server
# ACP_DISCOVERY_BASE_URL=https://wt.ioa.pub/discovery
# ACP_CA_BASE_URL=https://wt.ioa.pub/ca-server
# ACP_MQ_HOST=localhost
# ACP_MQ_PORT=5671
# ACP_MQ_VHOST=acps
# ACP_AMP_LOG_PATH=logs/amp.jsonl
